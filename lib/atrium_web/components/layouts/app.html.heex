
<%= if assigns[:nav] && @nav != [] do %>
  <% nav_keys = MapSet.new(@nav, &to_string(&1.key))
     nav_by_key = Map.new(@nav, fn e -> {to_string(e.key), e} end)
     path = @conn.request_path

     section_link = fn key ->
       dedicated = ~w(home news directory tools compliance helpdesk events learning feedback projects community)
       if key in dedicated, do: "/#{key}", else: "/sections/#{key}/documents"
     end

     subsection_links = fn key ->
       case Map.get(nav_by_key, key) do
         %{children: children} when children != [] ->
           Enum.map(children, &%{label: &1.name, path: "/sections/#{key}/documents?subsection=#{&1.slug}"})
         _ -> []
       end
     end

     hub_groups = [
       %{
         label: "News",
         requires: ["news"],
         href: "/news",
         columns: [
           %{
             title: "News & Announcements",
             links: [
               %{label: "Latest news", path: "/news"},
               %{label: "Pinned announcements", path: "/home"}
             ]
           },
           %{
             title: "Events",
             requires: "events",
             links: [
               %{label: "Calendar", path: "/events"},
               %{label: "Upcoming", path: "/events"}
             ]
           },
           %{
             title: "Community",
             requires: "community",
             links: [
               %{label: "Discussions", path: "/community"}
             ]
           }
         ]
       },
       %{
         label: "Our Organisation",
         requires: ["directory", "hr", "departments"],
         href: "/directory",
         columns: [
           %{
             title: "People",
             links: [
               %{label: "Staff Directory", path: "/directory", requires: "directory"},
               %{label: "Org Chart", path: "/directory", requires: "directory"}
             ]
           },
           %{
             title: "HR & People Services",
             requires: "hr",
             links: ([%{label: "HR Portal", path: section_link.("hr")},
                      %{label: "Policies", path: "/sections/hr/documents"},
                      %{label: "Forms", path: "/sections/hr/forms"}]
                     ++ subsection_links.("hr")) |> Enum.uniq_by(& &1.label)
           },
           %{
             title: "Departments & Teams",
             requires: "departments",
             links: ([%{label: "All departments", path: section_link.("departments")}]
                     ++ subsection_links.("departments")) |> Enum.uniq_by(& &1.label)
           }
         ]
       },
       %{
         label: "Systems & Processes",
         requires: ["compliance", "tools", "helpdesk"],
         href: "/tools",
         columns: [
           %{
             title: "Compliance & Quality",
             requires: "compliance",
             links: [
               %{label: "Compliance Portal", path: "/compliance"},
               %{label: "Controlled Documents", path: "/sections/docs/documents", requires: "docs"},
               %{label: "Incident Management", path: "/sections/compliance/forms"}
             ]
           },
           %{
             title: "IT & Support",
             requires: "helpdesk",
             links: [
               %{label: "Help Desk", path: "/helpdesk"},
               %{label: "Submit Ticket", path: "/helpdesk"}
             ]
           },
           %{
             title: "Tools & Applications",
             requires: "tools",
             links: [
               %{label: "All Tools", path: "/tools"}
             ]
           }
         ]
       },
       %{
         label: "Resources",
         requires: ["docs", "learning"],
         href: "/learning",
         columns: [
           %{
             title: "Knowledge Base",
             requires: "docs",
             links: ([%{label: "Browse documents", path: section_link.("docs")}]
                     ++ subsection_links.("docs")) |> Enum.uniq_by(& &1.label)
           },
           %{
             title: "Learning & Development",
             requires: "learning",
             links: [
               %{label: "All courses", path: "/learning"},
               %{label: "New course", path: "/learning/new"}
             ]
           },
           %{
             title: "Projects",
             requires: "projects",
             links: [
               %{label: "All projects", path: "/projects"},
               %{label: "New project", path: "/projects/new"}
             ]
           }
         ]
       }
     ]

     filter_link = fn link ->
       case Map.get(link, :requires) do
         nil -> true
         k -> MapSet.member?(nav_keys, k)
       end
     end

     filter_column = fn col ->
       case Map.get(col, :requires) do
         nil -> col.links |> Enum.filter(filter_link) |> length() > 0
         k -> MapSet.member?(nav_keys, k) and col.links |> Enum.filter(filter_link) |> length() > 0
       end
     end

     visible_groups =
       Enum.flat_map(hub_groups, fn group ->
         if Enum.any?(group.requires, &MapSet.member?(nav_keys, &1)) do
           cols = Enum.filter(group.columns, filter_column)
           if cols == [], do: [], else: [%{group | columns: cols}]
         else
           []
         end
       end)
  %>
  <nav class="atrium-hubnav" aria-label="Hub navigation">
    <div class="atrium-hubnav-inner">
      <a href="/" class="atrium-hubnav-brand">
        <% logo_url = assigns[:tenant] && get_in(@tenant.theme || %{}, ["logo_url"]) %>
        <%= if logo_url do %>
          <img src={logo_url} alt={@tenant.name} style="height:24px;max-width:110px;object-fit:contain" />
        <% else %>
          <div class="atrium-brand-icon">
            <svg viewBox="0 0 16 16"><path d="M8 1L2 5v8h4v-4h4v4h4V5L8 1z"/></svg>
          </div>
          <span class="atrium-hubnav-brand-name"><%= if assigns[:tenant], do: @tenant.name, else: "Atrium" %></span>
        <% end %>
      </a>
      <div class="atrium-hubnav-search">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" class="atrium-hubnav-search-icon">
          <circle cx="7" cy="7" r="4.5"/><path d="M11 11l2.5 2.5" stroke-linecap="round"/>
        </svg>
        <input type="text" id="topbar-search" data-search-input placeholder="Search…" autocomplete="off" />
        <kbd>⌘K</kbd>
      </div>
      <a href="/" class={"atrium-hubnav-item#{if path == "/", do: " active", else: ""}"}>
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" style="width:14px;height:14px">
          <path d="M2 8l6-5 6 5v6a1 1 0 0 1-1 1h-3v-4H6v4H3a1 1 0 0 1-1-1V8z" stroke-linejoin="round"/>
        </svg>
        Dashboard
      </a>
      <%= for group <- visible_groups do %>
        <div class="atrium-hubnav-group has-dropdown">
          <a href={group.href} class="atrium-hubnav-item">
            <%= group.label %>
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" style="width:10px;height:10px;margin-left:4px;opacity:.6">
              <path d="M4 6l4 4 4-4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <div class="atrium-hubnav-mega" style={"--col-count:#{length(group.columns)}"}>
            <div class="atrium-hubnav-mega-grid">
              <%= for col <- group.columns do %>
                <div class="atrium-hubnav-mega-col">
                  <div class="atrium-hubnav-mega-title"><%= col.title %></div>
                  <%= for link <- Enum.filter(col.links, filter_link) do %>
                    <a href={link.path} class="atrium-hubnav-mega-link"><%= link.label %></a>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>

      <div class="atrium-hubnav-spacer"></div>

      <a href={~p"/audit"} class={"atrium-hubnav-item#{if String.starts_with?(path, "/audit"), do: " active", else: ""}"}>
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" style="width:13px;height:13px;margin-right:4px">
          <path d="M2 4h12M2 8h8M2 12h5" stroke-linecap="round"/>
        </svg>
        Audit
      </a>

      <%= if assigns[:current_user] && @current_user.is_admin do %>
        <% admin_active = String.starts_with?(path, "/admin/") %>
        <div class="atrium-hubnav-group has-dropdown">
          <a href={~p"/admin/users"} class={"atrium-hubnav-item#{if admin_active, do: " active", else: ""}"}>
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" style="width:13px;height:13px;margin-right:4px" stroke-linecap="round">
              <circle cx="8" cy="5" r="2.5"/>
              <path d="M2.5 13c0-3 2.5-4.5 5.5-4.5s5.5 1.5 5.5 4.5"/>
            </svg>
            Admin
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" style="width:10px;height:10px;margin-left:4px;opacity:.6">
              <path d="M4 6l4 4 4-4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <div class="atrium-hubnav-mega atrium-hubnav-mega--right" style="--col-count:2;min-width:420px">
            <div class="atrium-hubnav-mega-grid">
              <div class="atrium-hubnav-mega-col">
                <div class="atrium-hubnav-mega-title">People</div>
                <a href={~p"/admin/users"} class="atrium-hubnav-mega-link">Users</a>
                <a href={~p"/admin/groups"} class="atrium-hubnav-mega-link">Groups</a>
              </div>
              <div class="atrium-hubnav-mega-col">
                <div class="atrium-hubnav-mega-title">Sections</div>
                <a href={~p"/admin/sections"} class="atrium-hubnav-mega-link">Section permissions</a>
                <a href={~p"/admin/sections/hr/subsections"} class="atrium-hubnav-mega-link">HR subsections</a>
                <a href={~p"/admin/sections/departments/subsections"} class="atrium-hubnav-mega-link">Department subsections</a>
                <a href={~p"/admin/sections/docs/subsections"} class="atrium-hubnav-mega-link">Knowledge base subsections</a>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <div class="atrium-hubnav-actions">
        <a href="/notifications" class="atrium-hubnav-iconbtn" title="Notifications">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75">
            <path d="M8 2a4.5 4.5 0 0 1 4.5 4.5c0 2.5.5 3.5 1.5 4.5H2c1-1 1.5-2 1.5-4.5A4.5 4.5 0 0 1 8 2zM6.5 13.5a1.5 1.5 0 0 0 3 0" stroke-linecap="round"/>
          </svg>
          <%= if assigns[:unread_notification_count] && @unread_notification_count > 0 do %>
            <span class="atrium-hubnav-iconbtn-dot"></span>
          <% end %>
        </a>
        <%= if assigns[:current_user] do %>
          <div class="atrium-hubnav-user">
            <div class="atrium-user-avatar">
              <%= @current_user.name |> String.split() |> Enum.map(&String.first/1) |> Enum.take(2) |> Enum.join() %>
            </div>
            <span class="atrium-hubnav-user-name"><%= @current_user.name %></span>
          </div>
        <% end %>
        <.link href={~p"/logout"} method="delete" class="atrium-hubnav-iconbtn" title="Sign out">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75">
            <path d="M6 3H3a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h3M10 11l3-3-3-3M13 8H6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </.link>
      </div>
    </div>
  </nav>
<% end %>

<div class="atrium-layout">
  <main class="atrium-main atrium-main--full">
    <.flash_group flash={@flash} />
    {@inner_content}
  </main>
</div>

<%= if assigns[:current_user] do %>
  <%!-- AI chat widget --%>
  <button id="atrium-ai-fab" class="atrium-ai-fab" type="button" title="Ask the assistant" aria-label="Ask AI assistant">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width:20px;height:20px">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
    </svg>
  </button>

  <div id="atrium-ai-panel" class="atrium-ai-panel" hidden style="display:none">
    <div class="atrium-ai-header">
      <div>
        <div class="atrium-ai-title">Ask the intranet</div>
        <div class="atrium-ai-sub">AI assistant · uses content you can view</div>
      </div>
      <div style="display:flex;gap:4px">
        <button type="button" id="atrium-ai-minimize" class="atrium-ai-iconbtn" aria-label="Minimize" title="Minimize">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px"><path d="M3 12h10" stroke-linecap="round"/></svg>
        </button>
        <button type="button" id="atrium-ai-close" class="atrium-ai-iconbtn" aria-label="Close" title="Close and reset">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px"><path d="M2 2l12 12M14 2L2 14" stroke-linecap="round"/></svg>
        </button>
      </div>
    </div>
    <div id="atrium-ai-messages" class="atrium-ai-messages">
      <div class="atrium-ai-msg atrium-ai-msg--assistant">
        <div class="atrium-ai-bubble">Hi <%= hd(String.split(@current_user.name)) %> — ask me anything about policies, courses, people, or events.</div>
      </div>
    </div>
    <form id="atrium-ai-form" class="atrium-ai-form" autocomplete="off">
      <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
      <input id="atrium-ai-input" type="text" placeholder="Where do I find the holiday policy?" required />
      <button type="submit" class="atrium-ai-send" aria-label="Send">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:14px;height:14px"><path d="M2 8h12M8 2l6 6-6 6"/></svg>
      </button>
    </form>
  </div>
<% end %>

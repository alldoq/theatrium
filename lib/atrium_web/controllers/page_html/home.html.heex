<div class="atrium-anim">
  <%!-- Hero band --%>
  <div class="atrium-hero">
    <div class="atrium-hero-pattern" aria-hidden="true"></div>
    <div class="atrium-hero-inner">
      <div class="atrium-page-eyebrow" style="color:var(--text-tertiary)">Dashboard</div>
      <h1 class="atrium-hero-title">
        <%= if @current_user, do: "Welcome back, #{hd(String.split(@current_user.name))}", else: "Welcome to #{@tenant.name}" %>
      </h1>
      <p class="atrium-hero-meta">
        <span><%= @tenant.name %></span>
        <span class="atrium-hero-dot">·</span>
        <span><%= Calendar.strftime(Date.utc_today(), "%A, %-d %B %Y") %></span>
      </p>
    </div>
  </div>

  <%!-- Jump-to quick links --%>
  <div style="margin-bottom:28px">
    <div class="atrium-section-divider">
      <span class="atrium-section-label">Jump to</span>
      <div class="atrium-section-rule"></div>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:12px">
      <% jumps = [
        %{href: "/learning", label: "Training", sub: "Courses & induction", icon: "M3 8l5-5 5 5M8 3v10"},
        %{href: "/compliance", label: "Policies", sub: "Compliance docs", icon: "M8 2L3 4v4c0 3 2 5 5 6 3-1 5-3 5-6V4l-5-2z"},
        %{href: "/sections/hr/forms", label: "Forms", sub: "HR & requests", icon: "M3 2h10v12H3zM5 5h6M5 8h6M5 11h4"},
        %{href: "/sections/hr/documents", label: "Onboarding", sub: "New starter info", icon: "M8 1l6 3v4c0 4-3 7-6 8-3-1-6-4-6-8V4l6-3z"},
        %{href: "/directory", label: "Staff Directory", sub: "Find colleagues", icon: "M5.5 6a2 2 0 100-4 2 2 0 000 4zM10.5 6a2 2 0 100-4 2 2 0 000 4zM2 13c0-2 1.5-3.5 3.5-3.5S9 11 9 13M7 13c0-2 1.5-3.5 3.5-3.5S14 11 14 13"},
        %{href: "/tools", label: "Tools", sub: "Apps & services", icon: "M10 3l3 3-7 7-3 1 1-3 7-7zM10 3l2-2 3 3-2 2"}
      ] %>
      <%= for j <- jumps do %>
        <a href={j.href} class="atrium-jump-tile">
          <span class="atrium-jump-icon">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d={j.icon}/>
            </svg>
          </span>
          <span class="atrium-jump-text">
            <span class="atrium-jump-label"><%= j.label %></span>
            <span class="atrium-jump-sub"><%= j.sub %></span>
          </span>
          <svg class="atrium-jump-arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75">
            <path d="M6 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      <% end %>
    </div>
  </div>

  <%!-- Main grid: announcements + side tiles --%>
  <div style="display:grid;grid-template-columns:2fr 1fr;gap:20px;margin-bottom:20px">
    <%!-- Announcements --%>
    <div class="atrium-card">
      <div class="atrium-card-header" style="display:flex;align-items:center;justify-content:space-between">
        <div class="atrium-card-title">News &amp; Announcements</div>
        <a href={~p"/home"} style="font-size:.8125rem;color:var(--blue-600);text-decoration:none;font-weight:500">View all →</a>
      </div>
      <div class="atrium-card-body" style="padding-top:4px">
        <%= if @announcements == [] do %>
          <div class="atrium-empty">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width:32px;height:32px;color:var(--text-tertiary);margin-bottom:8px" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 11a9 9 0 0 1 18 0v7l-2-2H5l-2 2v-7z"/>
              <path d="M9 14h6"/>
            </svg>
            <div style="font-size:.875rem;color:var(--text-tertiary)">No announcements yet</div>
          </div>
        <% end %>
        <div style="display:flex;flex-direction:column">
          <%= for {ann, idx} <- Enum.with_index(@announcements) do %>
            <div class="atrium-announcement-row" style={if idx > 0, do: "border-top:1px solid var(--border)", else: ""}>
              <div class={"atrium-announcement-bar #{if ann.pinned, do: "is-pinned"}"}></div>
              <div style="flex:1;min-width:0">
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:3px">
                  <%= if ann.pinned do %>
                    <span class="atrium-chip">
                      <svg viewBox="0 0 16 16" fill="currentColor" style="width:10px;height:10px">
                        <path d="M10 1.5l4.5 4.5-3 1-3.5 3.5L7 13l-1-1 2.5-2.5L8 8 4.5 4.5 6 1l4 .5z"/>
                      </svg>
                      Pinned
                    </span>
                  <% end %>
                  <span style="font-size:.75rem;color:var(--text-tertiary)"><%= Calendar.strftime(ann.inserted_at, "%-d %b %Y") %></span>
                </div>
                <div style="font-weight:600;font-size:.9375rem;color:var(--text-primary);letter-spacing:-.005em"><%= ann.title %></div>
                <%= if ann.body_html && ann.body_html != "" do %>
                  <div style="font-size:.8125rem;color:var(--text-secondary);margin-top:4px;line-height:1.55;max-height:3em;overflow:hidden"><%= Phoenix.HTML.raw(ann.body_html) %></div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%!-- Side column tiles --%>
    <div style="display:flex;flex-direction:column;gap:16px">
      <%!-- Staff Directory tile --%>
      <a href={~p"/directory"} class="atrium-stat-tile">
        <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px">
          <div>
            <div style="font-size:.6875rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--text-tertiary);margin-bottom:6px">Staff</div>
            <div class="atrium-stat-value"><%= @staff_count %></div>
            <div style="font-size:.8125rem;color:var(--text-secondary);margin-top:2px">active <%= if @staff_count == 1, do: "member", else: "members" %></div>
          </div>
          <div class="atrium-stat-icon">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
              <circle cx="5.5" cy="6" r="2"/>
              <circle cx="10.5" cy="6" r="2"/>
              <path d="M2 13c0-2 1.5-3.5 3.5-3.5S9 11 9 13M7 13c0-2 1.5-3.5 3.5-3.5S14 11 14 13"/>
            </svg>
          </div>
        </div>
        <div class="atrium-stat-cta">
          Browse directory
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" style="width:12px;height:12px">
            <path d="M6 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      </a>

      <%!-- Onboarding tile --%>
      <div class="atrium-card">
        <div class="atrium-card-body">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px">
            <div class="atrium-tile-icon">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px">
                <path d="M8 1l6 3v4c0 4-3 7-6 8-3-1-6-4-6-8V4l6-3z"/>
              </svg>
            </div>
            <div>
              <div style="font-weight:600;font-size:.9375rem;color:var(--text-primary)">Onboarding</div>
              <div style="font-size:.75rem;color:var(--text-tertiary)">For new joiners</div>
            </div>
          </div>
          <div style="display:flex;flex-direction:column">
            <a href="/learning" class="atrium-tile-link">Induction Training</a>
            <a href="/sections/hr/documents" class="atrium-tile-link">Benefits</a>
            <a href="/directory" class="atrium-tile-link">Leadership / Org Chart</a>
          </div>
        </div>
      </div>

      <%!-- Upcoming events tile --%>
      <div class="atrium-card">
        <div class="atrium-card-header" style="padding-bottom:8px">
          <div class="atrium-card-title" style="font-size:.875rem">Upcoming events</div>
        </div>
        <div style="padding:0 20px 14px">
          <%= for event <- @upcoming_events do %>
            <a href={~p"/events/#{event.id}"} class="atrium-event-row">
              <div class="atrium-event-date">
                <div class="atrium-event-month"><%= Calendar.strftime(event.starts_at, "%b") %></div>
                <div class="atrium-event-day"><%= Calendar.strftime(event.starts_at, "%-d") %></div>
              </div>
              <div style="flex:1;min-width:0">
                <div style="font-weight:500;font-size:.8125rem;color:var(--text-primary);overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= event.title %></div>
                <%= if event.location do %>
                  <div style="font-size:.6875rem;color:var(--text-tertiary);margin-top:1px"><%= event.location %></div>
                <% end %>
              </div>
            </a>
          <% end %>
          <%= if @upcoming_events == [] do %>
            <div class="atrium-empty" style="padding:16px 0">
              <div style="font-size:.8125rem;color:var(--text-tertiary)">No upcoming events</div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <%!-- Pinned quick links from /home (if any) --%>
  <%= if @quick_links != [] do %>
    <div class="atrium-card">
      <div class="atrium-card-header">
        <div class="atrium-card-title">Pinned links</div>
      </div>
      <div class="atrium-card-body">
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:10px">
          <%= for link <- @quick_links do %>
            <a href={link.url} target="_blank" rel="noopener noreferrer" class="atrium-pinned-link">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" style="width:14px;height:14px;flex-shrink:0">
                <path d="M6.5 3.5H3a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h9a1 1 0 0 0 1-1v-3.5M9.5 2H14v4.5M14 2l-7 7" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= link.label %></span>
            </a>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>

<style>
  /* Hero band */
  .atrium-hero {
    position: relative;
    background: linear-gradient(180deg, var(--slate-50, #f8fafc) 0%, var(--surface, #fff) 100%);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 28px 28px 24px;
    margin-bottom: 32px;
    overflow: hidden;
  }
  .atrium-hero-pattern {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 1px 1px, var(--border) 1px, transparent 0);
    background-size: 20px 20px;
    opacity: .35;
    mask-image: linear-gradient(90deg, transparent 0%, #000 30%, #000 100%);
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 30%, #000 100%);
    pointer-events: none;
  }
  .atrium-hero-inner { position: relative; }
  .atrium-hero-title {
    font-size: 1.625rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -.025em;
    margin: 4px 0 6px 0;
    line-height: 1.15;
  }
  .atrium-hero-meta {
    font-size: .875rem;
    color: var(--text-secondary);
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .atrium-hero-dot { color: var(--text-tertiary); }

  /* Section divider */
  .atrium-section-divider {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
  }
  .atrium-section-label {
    font-size: .6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .1em;
    color: var(--text-tertiary);
  }
  .atrium-section-rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--border) 0%, transparent 100%);
  }

  /* Jump tiles */
  .atrium-jump-tile {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
    transition: border-color .15s, transform .15s, box-shadow .15s, background .15s;
    position: relative;
  }
  .atrium-jump-tile::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
    background: linear-gradient(135deg, var(--blue-50) 0%, transparent 60%);
    opacity: 0;
    transition: opacity .15s;
    pointer-events: none;
  }
  .atrium-jump-tile:hover {
    border-color: var(--blue-500);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(15,23,42,.06);
  }
  .atrium-jump-tile:hover::before { opacity: 1; }
  .atrium-jump-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 9px;
    flex-shrink: 0;
    background: var(--slate-50);
    color: var(--text-secondary);
    border: 1px solid var(--border);
    transition: background .15s, color .15s, border-color .15s;
    position: relative;
    z-index: 1;
  }
  .atrium-jump-icon svg { width: 16px; height: 16px; }
  .atrium-jump-tile:hover .atrium-jump-icon {
    background: var(--blue-500);
    color: #fff;
    border-color: var(--blue-500);
  }
  .atrium-jump-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1;
    position: relative;
    z-index: 1;
  }
  .atrium-jump-label {
    font-weight: 600;
    font-size: .875rem;
    color: var(--text-primary);
    line-height: 1.2;
  }
  .atrium-jump-sub {
    font-size: .75rem;
    color: var(--text-tertiary);
    margin-top: 2px;
  }
  .atrium-jump-arrow {
    width: 14px;
    height: 14px;
    color: var(--text-tertiary);
    flex-shrink: 0;
    transition: color .15s, transform .15s;
    position: relative;
    z-index: 1;
  }
  .atrium-jump-tile:hover .atrium-jump-arrow {
    color: var(--blue-600);
    transform: translateX(3px);
  }

  /* Announcement rows */
  .atrium-announcement-row {
    display: flex;
    gap: 12px;
    padding: 12px 0;
    align-items: stretch;
  }
  .atrium-announcement-bar {
    width: 3px;
    border-radius: 2px;
    background: var(--border);
    flex-shrink: 0;
  }
  .atrium-announcement-bar.is-pinned {
    background: var(--blue-500);
  }
  .atrium-chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: .625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: var(--blue-700);
    background: var(--blue-50);
    border-radius: 4px;
    padding: 2px 6px;
  }

  /* Stat tile (Staff Directory) */
  .atrium-stat-tile {
    display: block;
    padding: 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
    color: inherit;
    transition: border-color .15s, transform .15s, box-shadow .15s;
    position: relative;
    overflow: hidden;
  }
  .atrium-stat-tile::before {
    content: "";
    position: absolute;
    top: -40px;
    right: -40px;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: var(--blue-50);
    opacity: .5;
    transition: transform .25s ease;
  }
  .atrium-stat-tile:hover {
    border-color: var(--blue-500);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(15,23,42,.06);
  }
  .atrium-stat-tile:hover::before { transform: scale(1.15); }
  .atrium-stat-value {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -.03em;
    line-height: 1;
    position: relative;
  }
  .atrium-stat-icon {
    width: 36px;
    height: 36px;
    border-radius: 9px;
    background: var(--blue-50);
    color: var(--blue-600);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }
  .atrium-stat-icon svg { width: 18px; height: 18px; }
  .atrium-stat-cta {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: .8125rem;
    color: var(--blue-600);
    font-weight: 500;
    margin-top: 14px;
    position: relative;
    transition: gap .15s;
  }
  .atrium-stat-tile:hover .atrium-stat-cta { gap: 8px; }

  /* Tile icon (Onboarding etc.) */
  .atrium-tile-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: var(--slate-50);
    color: var(--text-secondary);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .atrium-tile-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 0;
    border-bottom: 1px solid var(--border);
    font-size: .8125rem;
    color: var(--text-primary);
    text-decoration: none;
    transition: color .12s, padding .15s;
  }
  .atrium-tile-link:last-child { border-bottom: none; }
  .atrium-tile-link::after {
    content: "→";
    color: var(--text-tertiary);
    font-size: .875rem;
    transition: color .12s, transform .15s;
  }
  .atrium-tile-link:hover {
    color: var(--blue-600);
    padding-left: 4px;
  }
  .atrium-tile-link:hover::after {
    color: var(--blue-600);
    transform: translateX(2px);
  }

  /* Event rows */
  .atrium-event-row {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 8px 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    transition: padding .15s;
  }
  .atrium-event-row:last-child { border-bottom: none; }
  .atrium-event-row:hover { padding-left: 4px; }
  .atrium-event-date {
    min-width: 40px;
    text-align: center;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 3px 4px;
    flex-shrink: 0;
  }
  .atrium-event-month {
    font-size: .625rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--text-tertiary);
    letter-spacing: .04em;
  }
  .atrium-event-day {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.1;
    letter-spacing: -.02em;
  }

  /* Empty state */
  .atrium-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 28px 0;
    text-align: center;
  }

  /* Pinned link tiles */
  .atrium-pinned-link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
    color: var(--text-secondary);
    font-size: .8125rem;
    font-weight: 500;
    transition: border-color .12s, color .12s, background .12s;
  }
  .atrium-pinned-link:hover {
    border-color: var(--blue-500);
    color: var(--blue-700);
    background: var(--blue-50);
  }
  .atrium-pinned-link svg { color: var(--text-tertiary); }
  .atrium-pinned-link:hover svg { color: var(--blue-600); }
</style>

<div class="atrium-anim">
  <%!-- Hero --%>
  <div style="background:linear-gradient(135deg,var(--blue-600) 0%,var(--blue-500) 50%,#6366f1 100%);border-radius:var(--radius);padding:32px;color:#fff;margin-bottom:24px;position:relative;overflow:hidden">
    <div style="position:absolute;top:-40px;right:-40px;width:180px;height:180px;border-radius:50%;background:rgba(255,255,255,.08)"></div>
    <div style="position:absolute;bottom:-60px;right:60px;width:120px;height:120px;border-radius:50%;background:rgba(255,255,255,.06)"></div>
    <div style="position:relative">
      <div style="font-size:.75rem;font-weight:600;text-transform:uppercase;letter-spacing:.08em;opacity:.85;margin-bottom:6px">Dashboard</div>
      <h1 style="font-size:1.75rem;font-weight:700;margin:0 0 6px 0;letter-spacing:-.02em">
        <%= if @current_user, do: "Welcome back, #{hd(String.split(@current_user.name))}", else: "Welcome to #{@tenant.name}" %>
      </h1>
      <p style="font-size:.9375rem;opacity:.85;margin:0">
        <%= @tenant.name %> · <%= Calendar.strftime(Date.utc_today(), "%A, %-d %B %Y") %>
      </p>
    </div>
  </div>

  <%!-- Jump-to quick links --%>
  <div style="margin-bottom:24px">
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px">
      <span style="font-size:.6875rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--text-tertiary)">Jump to</span>
      <div style="flex:1;height:1px;background:var(--border)"></div>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:10px">
      <% jumps = [
        %{href: "/learning", label: "Training", color: "#10b981", icon: "M3 8l5-5 5 5M8 3v10"},
        %{href: "/compliance", label: "Policies", color: "#f59e0b", icon: "M8 2L3 4v4c0 3 2 5 5 6 3-1 5-3 5-6V4l-5-2z"},
        %{href: "/sections/hr/forms", label: "Forms", color: "#6366f1", icon: "M3 2h10v12H3zM5 5h6M5 8h6M5 11h4"},
        %{href: "/sections/hr/documents", label: "Onboarding", color: "#ec4899", icon: "M8 1l6 3v4c0 4-3 7-6 8-3-1-6-4-6-8V4l6-3z"},
        %{href: "/directory", label: "Staff Directory", color: "#06b6d4", icon: "M5.5 6a2 2 0 100-4 2 2 0 000 4zM10.5 6a2 2 0 100-4 2 2 0 000 4zM2 13c0-2 1.5-3.5 3.5-3.5S9 11 9 13M7 13c0-2 1.5-3.5 3.5-3.5S14 11 14 13"},
        %{href: "/tools", label: "Tools", color: "#8b5cf6", icon: "M10 3l3 3-7 7-3 1 1-3 7-7zM10 3l2-2 3 3-2 2"}
      ] %>
      <%= for j <- jumps do %>
        <a href={j.href} class="atrium-jump-tile" style={"--accent:#{j.color}"}>
          <span class="atrium-jump-icon" style={"background:#{j.color}1a;color:#{j.color}"}>
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d={j.icon}/>
            </svg>
          </span>
          <span style="font-weight:600;font-size:.875rem;color:var(--text-primary)"><%= j.label %></span>
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" style="width:14px;height:14px;color:var(--text-tertiary);margin-left:auto">
            <path d="M6 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      <% end %>
    </div>
  </div>

  <%!-- Main grid: announcements + side tiles --%>
  <div style="display:grid;grid-template-columns:2fr 1fr;gap:20px;margin-bottom:20px">
    <%!-- Announcements --%>
    <div class="atrium-card">
      <div class="atrium-card-header" style="display:flex;align-items:center;justify-content:space-between">
        <div class="atrium-card-title">News &amp; Announcements</div>
        <a href={~p"/home"} style="font-size:.8125rem;color:var(--blue-600);text-decoration:none">View all →</a>
      </div>
      <div class="atrium-card-body" style="padding-top:0">
        <%= if @announcements == [] do %>
          <div style="padding:20px 0;text-align:center;color:var(--text-tertiary);font-size:.875rem">No announcements yet.</div>
        <% end %>
        <div style="display:flex;flex-direction:column;gap:10px">
          <%= for ann <- @announcements do %>
            <div style={"border-left:3px solid #{if ann.pinned, do: "var(--blue-500)", else: "var(--border)"};padding:10px 0 10px 12px"}>
              <div style="display:flex;align-items:center;gap:8px;margin-bottom:2px">
                <%= if ann.pinned do %>
                  <span style="font-size:.625rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--blue-500)">Pinned</span>
                <% end %>
                <span style="font-size:.75rem;color:var(--text-tertiary)"><%= Calendar.strftime(ann.inserted_at, "%-d %b %Y") %></span>
              </div>
              <div style="font-weight:600;font-size:.9375rem;color:var(--text-primary)"><%= ann.title %></div>
              <%= if ann.body_html && ann.body_html != "" do %>
                <div style="font-size:.8125rem;color:var(--text-secondary);margin-top:2px;line-height:1.5;max-height:3em;overflow:hidden"><%= Phoenix.HTML.raw(ann.body_html) %></div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%!-- Side column tiles --%>
    <div style="display:flex;flex-direction:column;gap:16px">
      <%!-- Staff Directory tile --%>
      <a href={~p"/directory"} style="text-decoration:none;color:inherit">
        <div class="atrium-card" style="cursor:pointer;transition:transform .12s,box-shadow .12s" onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 4px 16px rgba(0,0,0,.08)'" onmouseout="this.style.transform='';this.style.boxShadow=''">
          <div class="atrium-card-body">
            <div style="display:flex;align-items:center;gap:12px">
              <div style="width:40px;height:40px;border-radius:10px;background:#06b6d41a;color:#06b6d4;display:flex;align-items:center;justify-content:center">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" style="width:20px;height:20px" stroke-linecap="round">
                  <circle cx="5.5" cy="6" r="2"/>
                  <circle cx="10.5" cy="6" r="2"/>
                  <path d="M2 13c0-2 1.5-3.5 3.5-3.5S9 11 9 13M7 13c0-2 1.5-3.5 3.5-3.5S14 11 14 13"/>
                </svg>
              </div>
              <div style="flex:1">
                <div style="font-weight:600;font-size:.9375rem;color:var(--text-primary)">Staff Directory</div>
                <div style="font-size:.8125rem;color:var(--text-tertiary)"><%= @staff_count %> active <%= if @staff_count == 1, do: "member", else: "members" %></div>
              </div>
            </div>
          </div>
        </div>
      </a>

      <%!-- Onboarding tile --%>
      <div class="atrium-card">
        <div class="atrium-card-body">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px">
            <div style="width:32px;height:32px;border-radius:8px;background:#ec48991a;color:#ec4899;display:flex;align-items:center;justify-content:center">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" style="width:16px;height:16px" stroke-linecap="round" stroke-linejoin="round">
                <path d="M8 1l6 3v4c0 4-3 7-6 8-3-1-6-4-6-8V4l6-3z"/>
              </svg>
            </div>
            <div style="font-weight:600;font-size:.9375rem;color:var(--text-primary)">Onboarding</div>
          </div>
          <div style="display:flex;flex-direction:column;gap:6px">
            <a href="/learning" style="font-size:.8125rem;color:var(--blue-600);text-decoration:none">Induction Training →</a>
            <a href="/sections/hr/documents" style="font-size:.8125rem;color:var(--blue-600);text-decoration:none">Benefits →</a>
            <a href="/directory" style="font-size:.8125rem;color:var(--blue-600);text-decoration:none">Leadership / Org Chart →</a>
          </div>
        </div>
      </div>

      <%!-- Upcoming events tile --%>
      <div class="atrium-card">
        <div class="atrium-card-header">
          <div class="atrium-card-title" style="font-size:.875rem">Upcoming events</div>
        </div>
        <div style="padding:0 20px 12px">
          <%= for event <- @upcoming_events do %>
            <div style="display:flex;gap:10px;align-items:flex-start;padding:8px 0;border-bottom:1px solid var(--border)">
              <div style="min-width:36px;text-align:center;background:var(--blue-50);border-radius:6px;padding:3px 4px">
                <div style="font-size:.625rem;font-weight:600;text-transform:uppercase;color:var(--blue-600)"><%= Calendar.strftime(event.starts_at, "%b") %></div>
                <div style="font-size:1rem;font-weight:700;color:var(--blue-700);line-height:1.1"><%= Calendar.strftime(event.starts_at, "%-d") %></div>
              </div>
              <div style="flex:1;min-width:0">
                <a href={~p"/events/#{event.id}"} style="font-weight:500;font-size:.8125rem;color:var(--text-primary);text-decoration:none"><%= event.title %></a>
              </div>
            </div>
          <% end %>
          <%= if @upcoming_events == [] do %>
            <div style="padding:14px 0;text-align:center;color:var(--text-tertiary);font-size:.8125rem">No upcoming events.</div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <%!-- Pinned quick links from /home (if any) --%>
  <%= if @quick_links != [] do %>
    <div class="atrium-card">
      <div class="atrium-card-header">
        <div class="atrium-card-title">Pinned links</div>
      </div>
      <div class="atrium-card-body">
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:10px">
          <%= for link <- @quick_links do %>
            <a href={link.url} target="_blank" rel="noopener noreferrer"
               style="display:flex;align-items:center;gap:8px;padding:10px 12px;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface);text-decoration:none;color:var(--text-primary);font-size:.8125rem;font-weight:500">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" style="width:14px;height:14px;color:var(--blue-500);flex-shrink:0">
                <path d="M6.5 3.5H3a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h9a1 1 0 0 0 1-1v-3.5M9.5 2H14v4.5M14 2l-7 7" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= link.label %></span>
            </a>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>

<style>
  .atrium-jump-tile {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
    transition: border-color .15s, transform .12s, box-shadow .15s;
  }
  .atrium-jump-tile:hover {
    border-color: var(--accent, var(--blue-500));
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(0,0,0,.06);
  }
  .atrium-jump-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    flex-shrink: 0;
  }
  .atrium-jump-icon svg { width: 16px; height: 16px; }
</style>

<div class="atrium-anim">
  <div style="margin-bottom:24px">
    <div class="atrium-page-eyebrow">Inbox</div>
    <h1 class="atrium-page-title">Notifications</h1>
  </div>

  <div class="atrium-card">
    <%= if @items == [] do %>
      <div style="padding:48px;text-align:center;color:var(--text-tertiary)">
        You have no notifications.
      </div>
    <% else %>
      <ul style="list-style:none;margin:0;padding:0">
        <%= for %{notification: n, link: link} <- @items do %>
          <% unread = is_nil(n.read_at) %>
          <li style={"border-bottom:1px solid var(--border);#{if unread, do: "background:color-mix(in srgb,var(--blue-500) 6%,transparent)", else: ""}"}>
            <%= if link do %>
              <a href={~p"/notifications/#{n.id}/go"} class="atrium-notif-row">
                <div style="flex:1;min-width:0">
                  <div style={"font-size:.9375rem;color:var(--text-primary);#{if unread, do: "font-weight:600", else: ""}"}><%= n.title %></div>
                  <%= if n.body do %>
                    <div style="font-size:.8125rem;color:var(--text-secondary);margin-top:2px"><%= n.body %></div>
                  <% end %>
                  <div style="font-size:.75rem;color:var(--text-tertiary);margin-top:4px">
                    <%= Calendar.strftime(n.inserted_at, "%d %b %Y, %H:%M") %>
                  </div>
                </div>
                <span class="atrium-notif-cta">
                  Open
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" style="width:13px;height:13px">
                    <path d="M6 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </a>
            <% else %>
              <div class="atrium-notif-row atrium-notif-row--static">
                <div style="flex:1;min-width:0">
                  <div style={"font-size:.9375rem;color:var(--text-primary);#{if unread, do: "font-weight:600", else: ""}"}><%= n.title %></div>
                  <%= if n.body do %>
                    <div style="font-size:.8125rem;color:var(--text-secondary);margin-top:2px"><%= n.body %></div>
                  <% end %>
                  <div style="font-size:.75rem;color:var(--text-tertiary);margin-top:4px">
                    <%= Calendar.strftime(n.inserted_at, "%d %b %Y, %H:%M") %>
                  </div>
                </div>
                <%= if unread do %>
                  <form action={~p"/notifications/#{n.id}/read"} method="post" style="flex-shrink:0">
                    <input type="hidden" name="_csrf_token" value={Phoenix.Controller.get_csrf_token()} />
                    <button type="submit" class="atrium-btn atrium-btn-ghost" style="font-size:.8125rem;padding:4px 10px">
                      Mark read
                    </button>
                  </form>
                <% end %>
              </div>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>

<style>
  .atrium-notif-row {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 14px 20px;
    text-decoration: none;
    color: inherit;
    transition: background .1s;
  }
  a.atrium-notif-row:hover { background: var(--slate-50, #f1f5f9); }
  .atrium-notif-row--static { cursor: default; }
  .atrium-notif-cta {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
    align-self: center;
    font-size: .8125rem;
    font-weight: 500;
    color: var(--blue-600);
    transition: gap .12s;
  }
  a.atrium-notif-row:hover .atrium-notif-cta { gap: 8px; }
</style>

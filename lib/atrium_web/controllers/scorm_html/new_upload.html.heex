<div class="atrium-anim" style="max-width:720px">
  <div style="margin-bottom:20px">
    <a href={~p"/learning/#{@course.id}"} style="font-size:.8125rem;color:var(--text-tertiary);text-decoration:none">← Back to course</a>
  </div>

  <div style="margin-bottom:24px">
    <div class="atrium-page-eyebrow">Learning · SCORM</div>
    <h1 class="atrium-page-title"><%= @course.title %></h1>
    <p class="atrium-page-subtitle">Upload a SCORM 1.2 package (.zip) to enable an interactive course.</p>
  </div>

  <div class="atrium-card" style="margin-bottom:24px">
    <div class="atrium-card-body">
      <form id="scorm-upload-form" method="post" action={~p"/learning/#{@course.id}/scorm"} enctype="multipart/form-data" style="display:flex;flex-direction:column;gap:14px">
        <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
        <div>
          <label class="atrium-label">SCORM package (.zip)</label>
          <div class="scorm-file-row">
            <label for="scorm-file-input" class="atrium-btn atrium-btn-ghost" style="cursor:pointer;margin:0">Choose file…</label>
            <input id="scorm-file-input" type="file" name="scorm[file]" accept=".zip,application/zip" required style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />
            <span id="scorm-file-name" style="font-size:.875rem;color:var(--text-tertiary)">No file selected</span>
          </div>
          <div style="font-size:.75rem;color:var(--text-tertiary);margin-top:6px">Max 500&nbsp;MB. Manifest <code>imsmanifest.xml</code> must be at the root of the archive.</div>
        </div>
        <div>
          <button type="submit" id="scorm-upload-submit" class="atrium-btn atrium-btn-primary" disabled>Upload</button>
        </div>
      </form>
    </div>
  </div>

  <%!-- Upload progress dialog --%>
  <div id="scorm-upload-dialog" class="scorm-upload-backdrop" style="display:none">
    <div class="scorm-upload-modal" role="dialog" aria-modal="true" aria-labelledby="scorm-upload-title">
      <div class="scorm-upload-header">
        <div id="scorm-upload-title" class="scorm-upload-titletext">Uploading package</div>
        <div id="scorm-upload-filename" class="scorm-upload-sub"></div>
      </div>
      <div class="scorm-upload-bar"><div id="scorm-upload-fill" class="scorm-upload-fill"></div></div>
      <div class="scorm-upload-meta">
        <span id="scorm-upload-percent">0%</span>
        <span id="scorm-upload-bytes"></span>
      </div>
      <div id="scorm-upload-stage" class="scorm-upload-stage">Preparing…</div>
      <div id="scorm-upload-error" class="scorm-upload-error" style="display:none"></div>
      <div class="scorm-upload-actions">
        <button type="button" id="scorm-upload-cancel" class="atrium-btn atrium-btn-ghost">Cancel</button>
        <button type="button" id="scorm-upload-close" class="atrium-btn atrium-btn-primary" style="display:none">Close</button>
      </div>
    </div>
  </div>

  <style>
    .scorm-upload-backdrop {
      position: fixed; inset: 0;
      background: rgba(15,23,42,.45);
      display: flex; align-items: center; justify-content: center;
      z-index: 200;
      backdrop-filter: blur(2px);
    }
    .scorm-upload-modal {
      background: #fff;
      border-radius: var(--radius);
      box-shadow: 0 20px 60px rgba(15,23,42,.25);
      padding: 24px;
      width: min(520px, 92vw);
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .scorm-upload-header { display: flex; flex-direction: column; gap: 4px; }
    .scorm-upload-titletext { font-size: 1rem; font-weight: 600; color: var(--text-primary); }
    .scorm-upload-sub { font-size: .8125rem; color: var(--text-tertiary); word-break: break-all; }
    .scorm-upload-bar {
      width: 100%; height: 8px;
      background: var(--slate-50, #f1f5f9);
      border-radius: 4px;
      overflow: hidden;
    }
    .scorm-upload-fill {
      width: 0%; height: 100%;
      background: linear-gradient(90deg, var(--blue-500), var(--blue-600));
      transition: width .15s ease;
      border-radius: 4px;
    }
    .scorm-upload-fill.indeterminate {
      width: 30%;
      animation: scorm-upload-pulse 1.4s ease-in-out infinite;
    }
    @keyframes scorm-upload-pulse {
      0%   { transform: translateX(-100%); }
      100% { transform: translateX(300%); }
    }
    .scorm-upload-meta {
      display: flex; justify-content: space-between;
      font-size: .75rem; color: var(--text-tertiary);
      font-variant-numeric: tabular-nums;
    }
    .scorm-upload-stage {
      font-size: .8125rem; color: var(--text-secondary);
    }
    .scorm-upload-error {
      background: #fee2e2; color: #991b1b;
      padding: 8px 12px; border-radius: 4px;
      font-size: .8125rem;
    }
    .scorm-upload-actions {
      display: flex; justify-content: flex-end; gap: 8px;
    }
    .scorm-file-row {
      display: flex; align-items: center; gap: 12px;
      position: relative;
    }
  </style>

  <script>
    (function() {
      const form = document.getElementById("scorm-upload-form");
      const dialog = document.getElementById("scorm-upload-dialog");
      const fill = document.getElementById("scorm-upload-fill");
      const pct = document.getElementById("scorm-upload-percent");
      const bytesEl = document.getElementById("scorm-upload-bytes");
      const fileEl = document.getElementById("scorm-upload-filename");
      const stage = document.getElementById("scorm-upload-stage");
      const errBox = document.getElementById("scorm-upload-error");
      const cancelBtn = document.getElementById("scorm-upload-cancel");
      const closeBtn = document.getElementById("scorm-upload-close");

      if (!form) return;

      const fileInputEl = document.getElementById("scorm-file-input");
      const fileNameEl = document.getElementById("scorm-file-name");
      const submitBtn = document.getElementById("scorm-upload-submit");

      function fmtBytesSmall(n) {
        if (n < 1024) return n + " B";
        if (n < 1024*1024) return (n/1024).toFixed(1) + " KB";
        if (n < 1024*1024*1024) return (n/(1024*1024)).toFixed(1) + " MB";
        return (n/(1024*1024*1024)).toFixed(2) + " GB";
      }

      if (fileInputEl) {
        fileInputEl.addEventListener("change", function() {
          if (fileInputEl.files && fileInputEl.files.length > 0) {
            const f = fileInputEl.files[0];
            fileNameEl.textContent = f.name + " · " + fmtBytesSmall(f.size);
            fileNameEl.style.color = "var(--text-primary)";
            if (submitBtn) submitBtn.disabled = false;
          } else {
            fileNameEl.textContent = "No file selected";
            fileNameEl.style.color = "var(--text-tertiary)";
            if (submitBtn) submitBtn.disabled = true;
          }
        });
      }

      let xhr;
      const courseShowUrl = <%= raw(Jason.encode!(~p"/learning/#{@course.id}")) %>;

      function fmtBytes(n) {
        if (!n) return "";
        if (n < 1024) return n + " B";
        if (n < 1024*1024) return (n/1024).toFixed(1) + " KB";
        if (n < 1024*1024*1024) return (n/(1024*1024)).toFixed(1) + " MB";
        return (n/(1024*1024*1024)).toFixed(2) + " GB";
      }

      function show(el)  { el.style.display = ""; el.hidden = false; }
      function hide(el)  { el.style.display = "none"; el.hidden = true; }

      function showError(msg) {
        errBox.textContent = msg;
        show(errBox);
        stage.textContent = "Upload failed.";
        fill.classList.remove("indeterminate");
        hide(cancelBtn);
        show(closeBtn);
        closeBtn.textContent = "Close";
      }

      function reset() {
        hide(dialog);
        hide(errBox);
        fill.style.width = "0%";
        fill.classList.remove("indeterminate");
        pct.textContent = "0%";
        bytesEl.textContent = "";
        show(cancelBtn);
        hide(closeBtn);
      }

      closeBtn.addEventListener("click", reset);

      cancelBtn.addEventListener("click", function() {
        if (xhr) {
          xhr.abort();
        }
        reset();
      });

      form.addEventListener("submit", function(e) {
        const fileInput = fileInputEl || form.querySelector('input[type="file"]');
        if (!fileInput || !fileInput.files || fileInput.files.length === 0) {
          e.preventDefault();
          if (fileInput && fileInput.reportValidity) fileInput.reportValidity();
          return;
        }
        const file = fileInput.files[0];

        e.preventDefault();

        // open dialog
        show(dialog);
        fileEl.textContent = file.name + " · " + fmtBytes(file.size);
        stage.textContent = "Uploading…";
        hide(errBox);
        fill.classList.remove("indeterminate");
        fill.style.width = "0%";
        pct.textContent = "0%";
        bytesEl.textContent = "0 / " + fmtBytes(file.size);
        show(cancelBtn);
        hide(closeBtn);

        const fd = new FormData(form);

        xhr = new XMLHttpRequest();
        xhr.open("POST", form.action, true);
        xhr.setRequestHeader("Accept", "text/html");

        xhr.upload.onprogress = function(ev) {
          if (ev.lengthComputable) {
            const p = Math.round((ev.loaded / ev.total) * 100);
            fill.style.width = p + "%";
            pct.textContent = p + "%";
            bytesEl.textContent = fmtBytes(ev.loaded) + " / " + fmtBytes(ev.total);
            if (p === 100) {
              stage.textContent = "Extracting and parsing manifest…";
              fill.classList.add("indeterminate");
              hide(cancelBtn);
            }
          }
        };

        xhr.onload = function() {
          // Phoenix redirects on success (302). XHR follows redirects to 200.
          // On 200/302 we treat as success and navigate to the course page.
          if (xhr.status >= 200 && xhr.status < 400) {
            stage.textContent = "Done.";
            fill.classList.remove("indeterminate");
            fill.style.width = "100%";
            window.location.href = courseShowUrl;
          } else if (xhr.status === 413) {
            showError("File too large. Max 500 MB.");
          } else {
            showError("Upload failed (HTTP " + xhr.status + "). Please try again.");
          }
        };

        xhr.onerror = function() {
          showError("Network error. Check your connection and try again.");
        };

        xhr.onabort = function() {
          // user cancelled — reset() already called
        };

        xhr.send(fd);
      });
    })();
  </script>

  <%= if @packages != [] do %>
    <div style="margin-bottom:12px">
      <div class="atrium-page-eyebrow">Uploaded packages</div>
    </div>
    <div class="atrium-card">
      <table class="atrium-table">
        <thead>
          <tr>
            <th>Title</th>
            <th>Version</th>
            <th>Size</th>
            <th>Uploaded</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <%= for pkg <- @packages do %>
            <tr>
              <td style="font-weight:500"><%= pkg.title %></td>
              <td>SCORM <%= pkg.version %></td>
              <td><%= pkg.byte_size && "#{div(pkg.byte_size, 1024)} KB" %></td>
              <td><%= Calendar.strftime(pkg.inserted_at, "%-d %b %Y %H:%M") %></td>
              <td style="text-align:right">
                <form method="post" action={~p"/learning/#{@course.id}/scorm/#{pkg.id}/delete"} style="display:inline">
                  <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
                  <button type="submit" class="atrium-btn atrium-btn-ghost" style="height:28px;font-size:.8125rem;color:var(--color-error)" onclick="return confirm('Remove this SCORM package and its uploaded files?')">Delete</button>
                </form>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>

<div class="atrium-anim" style="max-width:680px">
  <div style="margin-bottom:20px">
    <a href={~p"/customers/#{@customer_id}"} style="font-size:.8125rem;color:var(--text-tertiary);text-decoration:none">
      ← Back to customer
    </a>
  </div>

  <div style="margin-bottom:24px">
    <div class="atrium-page-eyebrow">Customers</div>
    <h1 class="atrium-page-title">Edit person</h1>
  </div>

  <.form
    :let={f}
    for={@changeset}
    action={~p"/customers/#{@customer_id}/people/#{@person.id}"}
    method="post"
  >
    <input type="hidden" name="_method" value="put" />

    <div class="atrium-card" style="margin-bottom:20px">
      <div class="atrium-card-body" style="display:flex;flex-direction:column;gap:16px">
        <div>
          <label class="atrium-label" for="person_name">Name</label>
          <.input field={f[:name]} type="text" class="atrium-input" />
        </div>
        <div>
          <label class="atrium-label" for="person_job_title">Job title</label>
          <.input field={f[:job_title]} type="text" class="atrium-input" />
        </div>
        <div>
          <label class="atrium-label" for="person_email">Email</label>
          <.input field={f[:email]} type="text" class="atrium-input" />
        </div>
        <div>
          <label class="atrium-label" for="person_phone">Phone</label>
          <.input field={f[:phone]} type="text" class="atrium-input" />
        </div>
        <div>
          <.input field={f[:primary]} type="checkbox" label="Primary contact" />
        </div>
      </div>
    </div>

    <div style="display:flex;gap:8px">
      <button type="submit" class="atrium-btn atrium-btn-primary">Save changes</button>
      <a href={~p"/customers/#{@customer_id}"} class="atrium-btn atrium-btn-ghost">Cancel</a>
    </div>
  </.form>
</div>

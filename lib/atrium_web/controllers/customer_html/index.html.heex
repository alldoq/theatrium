<div class="atrium-anim">
  <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:28px">
    <div>
      <div class="atrium-page-eyebrow">Customers</div>
      <h1 class="atrium-page-title">Contact Book</h1>
    </div>
    <.link :if={@can_edit} href={~p"/customers/new"} class="atrium-btn atrium-btn-primary">
      New customer
    </.link>
  </div>

  <form method="get" action={~p"/customers"} style="margin-bottom:20px">
    <input
      type="text"
      name="q"
      value={@query}
      placeholder="Search by name"
      class="atrium-input"
      style="max-width:360px"
    />
  </form>

  <div class="atrium-card">
    <table class="atrium-table">
      <thead>
        <tr>
          <th>Customer</th>
          <th>Website</th>
          <th>People</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <tr :for={customer <- @customers}>
          <td style="font-weight:500">
            <a href={~p"/customers/#{customer.id}"} style="color:var(--text-primary);text-decoration:none">
              {customer.name}
            </a>
          </td>
          <td style="font-size:.875rem;color:var(--text-secondary)">{customer.website}</td>
          <td style="font-size:.875rem;color:var(--text-secondary)">
            {customer.people_count} {if customer.people_count == 1, do: "person", else: "people"}
          </td>
          <td style="text-align:right">
            <a href={~p"/customers/#{customer.id}"} class="atrium-btn atrium-btn-ghost" style="height:28px;font-size:.8125rem">View</a>
          </td>
        </tr>
        <tr :if={@customers == []}>
          <td colspan="4" style="padding:32px;text-align:center;color:var(--text-tertiary)">
            No customers yet.<%= if @can_edit do %> <a href={~p"/customers/new"} style="color:var(--blue-600)">Create one</a>.<% end %>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
